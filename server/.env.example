# ===== Configuração do servidor LaundrFlow =====
# Copie este arquivo para ".env" e preencha com seus valores reais.

# String de conexão do MongoDB Atlas (Connect -> Drivers). Troque <password> pela senha real.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados
DB_NAME=laundrflow

# Segredo usado para assinar os tokens de sessão (JWT).
# Gere um valor longo e aleatório. Ex (PowerShell): [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Quanto tempo o login dura antes de expirar.
JWT_EXPIRES_IN=7d

# Porta HTTP (a maioria dos PaaS define PORT automaticamente; localmente usa 8080).
PORT=8080

# Admin criado automaticamente no primeiro boot (se ainda não existir nenhum usuário).
# TROQUE a senha e, depois do primeiro login, troque de novo pela interface.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-agora
